{
  "name": "victoriosa-autopilot",
  "private": true,
  "version": "0.4.0",
  "description": "Victoriosa ecommerce storefront and durable Autopilot V4 sourcing engine",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/autopilot/*.test.ts src/payments/*.test.ts src/storefront/*.test.ts src/integrations/*.test.ts src/security/*.test.ts",
    "eval:consultation-agents": "node --import tsx scripts/eval-consultation-agents.ts",
    "check:consultation-local-model": "node --import tsx scripts/check-consultation-local-model.ts",
    "build:vercel": "vite build && esbuild vercel-api.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/vercel-api.cjs",
    "test:db": "node --import tsx --test tests/sourcing-postgres.test.ts && node --import tsx --test tests/shadow-auth-postgres.test.ts",
    "test:commerce:db": "node scripts/test-commerce-postgres.mjs",
    "test:hosted-replay:db": "node scripts/test-hosted-replay-postgres.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run build:vercel"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "motion": "^12.23.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "24.x"
  }
}
