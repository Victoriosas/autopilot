# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEMO_MODE: When 'false' (default), demo data is never loaded into the store.
# Set to 'true' ONLY for development/demo purposes. Never deploy to production with DEMO_MODE=true.
DEMO_MODE="false"

# Currency conversion: EUR (catalog cost) → USD (checkout/PayPal)
EXCHANGE_RATE_EUR_USD="1.08"

# FIREBASE_*: Firebase project configuration (already set via firebase.ts)
# These are for reference - actual values are in src/lib/firebase.ts
# FIREBASE_API_KEY=""
# FIREBASE_AUTH_DOMAIN=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET=""
# FIREBASE_MESSAGING_SENDER_ID=""
# FIREBASE_APP_ID=""
# FIRESTORE_DATABASE_ID=""

# FIREBASE ADMIN SDK (for server-side operations, if needed):
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# PAYPal Configuration (REQUIRED for payments):
# Sandbox credentials for testing. Replace with live credentials for production.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
PAYPAL_WEBHOOK_ID=""
PAYPAL_CURRENCY="USD"

# AMAZON SP-API (optional - for Amazon connector):
# AMAZON_SP_API_REFRESH_TOKEN=""
# AMAZON_SP_API_CLIENT_ID=""
# AMAZON_SP_API_CLIENT_SECRET=""
# AMAZON_MARKETPLACE_ID=""

# ALIEXPRESS OPEN PLATFORM (optional - for AliExpress connector):
# ALIEXPRESS_APP_KEY=""
# ALIEXPRESS_APP_SECRET=""

# RATE LIMITING (optional):
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX_REQUESTS="30"
