# ============================================================
# Victoriosa Autopilot — Environment Variables
# ============================================================

# SUPABASE (REQUIRED):
# Frontend variables (VITE_ prefix = exposed to browser)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Backend variables (NEVER expose to frontend)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# GEMINI AI (REQUIRED for product discovery/analysis):
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PAYPAL (REQUIRED for payments):
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
PAYPAL_CURRENCY="USD"
EXCHANGE_RATE_EUR_USD="1.08"

# FIREBASE (DEPRECATED — kept for reference only):
# FIREBASE_API_KEY=""
# FIREBASE_AUTH_DOMAIN=""
# FIREBASE_PROJECT_ID=""

# AMAZON SP-API (optional):
# AMAZON_SP_API_REFRESH_TOKEN=""
# AMAZON_SP_API_CLIENT_ID=""

# ALIEXPRESS (optional):
# ALIEXPRESS_APP_KEY=""
# ALIEXPRESS_APP_SECRET=""
