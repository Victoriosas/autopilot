# ===========================================
# Victoriosa Autopilot - Environment Variables
# ===========================================
# Copy this file to .env.local for local development.
# Never commit real credentials.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CJ Dropshipping
# REST fallback. Keep configured while MCP-first sourcing is active in Shadow.
CJ_API_KEY=your-cj-api-key
# Official CJ remote MCP. Prefer CJ_MCP_TOKEN so the server constructs and validates
# the official HTTPS URL. CJ_MCP_SERVER_URL is optional for an official URL override.
CJ_MCP_TOKEN=your-cj-mcp-token
CJ_MCP_SERVER_URL=
# MCP participation is Shadow-only and still requires the global no-purchase/no-checkout gates.
CJ_MCP_SHADOW_ENABLED=false

# AI providers used by the general model router
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GEMINI_API_KEY=your-gemini-api-key

# Market Evidence provider chain
# Priority: Mercado Libre Uruguay -> Gemini Search Grounding -> OpenRouter Web Search.
# Each provider may be omitted independently. If no provider can produce enough evidence,
# the candidate remains blocked instead of receiving an invented market price.
MERCADOLIBRE_ACCESS_TOKEN=
# Optional compatibility alias if your environment already uses this name.
ML_ACCESS_TOKEN=
AUTOPILOT_MARKET_MODEL=gemini-2.5-flash
AUTOPILOT_MARKET_OPENROUTER_MODEL=
# Emergency/provider-cost switch. true skips OpenRouter Market Evidence while preserving other providers.
AUTOPILOT_MARKET_OPENROUTER_DISABLED=false

# Autopilot v4 model routing
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
CEREBRAS_ANALYSIS_MODEL=gpt-oss-120b
CEREBRAS_REASONING_MODEL=gpt-oss-120b
OPENROUTER_FAST_MODEL=qwen/qwen3-8b
OPENROUTER_REASONING_MODEL=qwen/qwen3-8b
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_APP_NAME=Victoriosa Autopilot
CODEX_REVIEW_MODEL=codex-governor

# Governance defaults - fail closed
AUTOPILOT_PURCHASE_LIMIT_USD=0
AUTOPILOT_ADMIN_TOKEN=replace-with-long-random-admin-token
AUTOPILOT_CODEX_TOKEN=replace-with-separate-long-random-codex-token
AUTOPILOT_LEGACY_SOURCING_ENABLED=false
AUTOPILOT_V4_SOURCING_ENABLED=false
AUTOPILOT_SHADOW_MODE=true
AUTOPILOT_V4_DESTINATION=UY
AUTOPILOT_V4_KEYWORD=facial headband
# Leave unset until a reviewed margin policy exists outside the bounded admin Shadow policy.
AUTOPILOT_V4_MIN_MARGIN_PCT=
MAX_CANDIDATES_PER_RUN=10
MAX_AI_CALLS_PER_RUN=6
MAX_RUN_DURATION_MS=20000
MAX_RETRIES_PER_ITEM=3
CRON_SECRET=replace-with-long-random-cron-secret

# CJ live evidence
AUTOPILOT_CJ_CURRENCY=USD
# Configure a reviewed operational FX source. Never hardcode a guessed exchange rate in production.
AUTOPILOT_CJ_TO_STORE_RATE=
# Set true only after confirming your CJ account/terms permit product-image commercial use.
AUTOPILOT_CJ_IMAGE_SALE_USE_ALLOWED=false
# Optional Shadow-only proxies. Code must ignore this when AUTOPILOT_SHADOW_MODE=false.
AUTOPILOT_CJ_SHADOW_COMMERCIAL_PROXIES=false

# Reviewed pricing policy. Missing values intentionally keep candidates in needs_evidence.
AUTOPILOT_CUSTOMS_RATE_PCT=
AUTOPILOT_PAYMENT_FEE_PCT=
AUTOPILOT_PAYMENT_FEE_FIXED=
AUTOPILOT_RETURN_RESERVE_PCT=
AUTOPILOT_ACQUISITION_COST=
AUTOPILOT_TAX_RATE_PCT=

# Storefront
# Demo fixtures must never be used as a production catalog.
VITE_DEMO_MODE=false
VITE_SALES_WHATSAPP=
VITE_STORE_CURRENCY=UYU
VITE_SHIPPING_FLAT=0
VITE_FREE_SHIPPING_FROM=0
VITE_BANK_TRANSFER_LABEL=Transferencia bancaria
VITE_BANK_TRANSFER_INSTRUCTIONS=

# Server-authoritative storefront values
STORE_CURRENCY=UYU
STORE_SHIPPING_FLAT=0
STORE_FREE_SHIPPING_FROM=0
BANK_TRANSFER_PUBLIC_LABEL=Transferencia bancaria
BANK_TRANSFER_PUBLIC_INSTRUCTIONS=
PUBLIC_APP_URL=https://your-production-domain.example

# Mercado Pago Uruguay - server only, never expose as VITE_*.
MERCADOPAGO_ACCESS_TOKEN=your-production-access-token

# PayPal
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_ENV=live
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_STORE_TO_USD_RATE=
# Legacy pricing helper only. Payment v2 does not trust this browser value.
EXCHANGE_RATE_EUR_USD=1.08

# Server
PORT=3000
NODE_ENV=production

# Frontend API URL, only when frontend/backend origins differ.
VITE_API_URL=https://your-backend-url

# Keep disabled until provider sandbox, stock, currency, fulfillment and payment checks pass.
CHECKOUT_ENABLED=false
