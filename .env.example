# ===========================================
# Victoriosa Autopilot - Environment Variables
# ===========================================
# Copy this to .env.local and fill in values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CJ Dropshipping
CJ_API_KEY=your-cj-api-key

# AI Providers (Multi-provider fallback: Groq → Cerebras → OpenRouter)
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional Google Gemini key used only by shadow Market Evidence with Google Search grounding.
# The engine fails closed to needs_evidence when this is not configured.
GEMINI_API_KEY=your-gemini-api-key
AUTOPILOT_MARKET_MODEL=gemini-2.5-flash

# Autopilot v4 model routing
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
CEREBRAS_ANALYSIS_MODEL=gpt-oss-120b
CEREBRAS_REASONING_MODEL=gpt-oss-120b
OPENROUTER_FAST_MODEL=qwen/qwen3-8b
OPENROUTER_REASONING_MODEL=qwen/qwen3-8b
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_APP_NAME=Victoriosa Autopilot
CODEX_REVIEW_MODEL=codex-governor

# Governance defaults
AUTOPILOT_PURCHASE_LIMIT_USD=0
AUTOPILOT_ADMIN_TOKEN=replace-with-long-random-admin-token
AUTOPILOT_CODEX_TOKEN=replace-with-separate-long-random-codex-token
# Legacy sourcing scheduler is intentionally fail-closed. Keep false unless you explicitly want to run the old draft-only sourcing loop.
AUTOPILOT_LEGACY_SOURCING_ENABLED=false
AUTOPILOT_V4_SOURCING_ENABLED=false
AUTOPILOT_SHADOW_MODE=true
AUTOPILOT_V4_DESTINATION=UY
AUTOPILOT_V4_KEYWORD=facial headband
# Leave unset until a reviewed margin policy and complete evidence exist.
AUTOPILOT_V4_MIN_MARGIN_PCT=
MAX_CANDIDATES_PER_RUN=10
MAX_AI_CALLS_PER_RUN=6
MAX_RUN_DURATION_MS=20000
MAX_RETRIES_PER_ITEM=3
# Vercel injects this only into the protected cron request; keep separate from admin tokens.
CRON_SECRET=replace-with-long-random-cron-secret

# CJ live evidence. CJ catalog/variant/freight prices are treated as provider-currency facts.
# Configure a reviewed FX source before converting them into STORE_CURRENCY. Never hardcode a guessed exchange rate.
AUTOPILOT_CJ_CURRENCY=USD
AUTOPILOT_CJ_TO_STORE_RATE=
# Set true only after confirming your CJ account/terms permit the product images to be used for sales in your store.
AUTOPILOT_CJ_IMAGE_SALE_USE_ALLOWED=false
# Optional shadow-only proxy signals from CJ listing velocity, listing count, live inventory, supplier identity and freight.
# The code structurally ignores this flag when AUTOPILOT_SHADOW_MODE=false.
AUTOPILOT_CJ_SHADOW_COMMERCIAL_PROXIES=false

# Reviewed pricing policy. Missing values intentionally keep candidates in needs_evidence.
AUTOPILOT_CUSTOMS_RATE_PCT=
AUTOPILOT_PAYMENT_FEE_PCT=
AUTOPILOT_PAYMENT_FEE_FIXED=
AUTOPILOT_RETURN_RESERVE_PCT=
AUTOPILOT_ACQUISITION_COST=
AUTOPILOT_TAX_RATE_PCT=

# Revenue checkout / public storefront
VITE_SALES_WHATSAPP=
VITE_STORE_CURRENCY=UYU
VITE_SHIPPING_FLAT=0
VITE_FREE_SHIPPING_FROM=0
VITE_BANK_TRANSFER_LABEL=Transferencia bancaria
VITE_BANK_TRANSFER_INSTRUCTIONS=

# Server-authoritative storefront values. These are the payment source of truth.
STORE_CURRENCY=UYU
STORE_SHIPPING_FLAT=0
STORE_FREE_SHIPPING_FROM=0
BANK_TRANSFER_PUBLIC_LABEL=Transferencia bancaria
BANK_TRANSFER_PUBLIC_INSTRUCTIONS=
# Production public HTTPS origin used for payment webhooks and return URLs.
PUBLIC_APP_URL=https://your-production-domain.example

# Mercado Pago Uruguay - server only. Never expose as VITE_*.
MERCADOPAGO_ACCESS_TOKEN=your-production-access-token

# PayPal
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_ENV=live
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your-webhook-id
# Multiplier from one STORE_CURRENCY unit to USD. Configure from your chosen operational FX source.
PAYPAL_STORE_TO_USD_RATE=
# Legacy pricing helper only; payment v2 does not trust this browser-side.
EXCHANGE_RATE_EUR_USD=1.08

# Server
PORT=3000
NODE_ENV=production

# Frontend API URL (for production)
VITE_API_URL=https://your-backend-url

# Keep disabled until provider sandbox, stock, currency and fulfillment checks pass.
CHECKOUT_ENABLED=false
