# ===========================================
# Victoriosa Autopilot - Environment Variables
# ===========================================
# Copy this to .env.local and fill in values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CJ Dropshipping
CJ_API_KEY=your-cj-api-key

# AI Providers (Multi-provider fallback: Groq → Cerebras → OpenRouter)
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Autopilot v4 model routing
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b
CEREBRAS_ANALYSIS_MODEL=gpt-oss-120b
CEREBRAS_REASONING_MODEL=gpt-oss-120b
OPENROUTER_FAST_MODEL=qwen/qwen3-8b
OPENROUTER_REASONING_MODEL=qwen/qwen3-8b
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_APP_NAME=Victoriosa Autopilot
CODEX_REVIEW_MODEL=codex-governor

# Governance defaults
# 0 disables autonomous purchases. Increase only after explicit review.
AUTOPILOT_PURCHASE_LIMIT_USD=0

# PayPal
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_ENV=live
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your-webhook-id
EXCHANGE_RATE_EUR_USD=1.08

# Server
PORT=3000
NODE_ENV=production

# Frontend API URL (for production)
VITE_API_URL=https://your-backend-url
