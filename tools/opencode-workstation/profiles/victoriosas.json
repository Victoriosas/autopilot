{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "ingeniero",
  "instructions": [
    "docs/OPENCODE_DIRECTIVES.md"
  ],
  "agent": {
    "sourcing": {
      "disable": true
    },
    "analyzer": {
      "disable": true
    },
    "seo": {
      "disable": true
    },
    "deploy": {
      "disable": true
    },
    "monitor": {
      "disable": true
    },
    "free-local": {
      "disable": true
    },
    "ecc-build-error-resolver": {
      "disable": true
    },
    "ecc-code-reviewer": {
      "disable": true
    },
    "ecc-database-reviewer": {
      "disable": true
    },
    "ecc-e2e-runner": {
      "disable": true
    },
    "ecc-security-reviewer": {
      "disable": true
    }
  },
  "share": "disabled",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=jfjzpwlrhzqbcrvqxhzf&read_only=true&features=database%2Cdebugging%2Cdocs",
      "enabled": false,
      "timeout": 15000
    }
  }
}
