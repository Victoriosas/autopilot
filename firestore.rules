rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Admins registry: only admins can manage; new admin records require existing admin to create
    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    // User profiles: users can view and update their own profile; admins can read all
    // Users CANNOT set their own role - only admins can assign admin role
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if isOwner(userId) && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products: public can read published/catalog products, but ONLY admin can mutate
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Supplier Directory & Agreements: strictly restricted to Administrators
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    // Autopilot execution runs, logs, and pipeline traces: strictly restricted to Administrators
    match /autopilot_runs/{runId} {
      allow read, write: if isAdmin();
    }

    // Audit logs for compliance & tracking: strictly restricted to Administrators
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Settings (Autopilot rules, thresholds, brand tone): public read for storefront defaults, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer orders:
    // Authenticated users can create orders (guests must sign in first)
    // Customers can read only their own orders
    // Admins can read, update, and manage all orders
    match /orders/{orderId} {
      allow create: if isSignedIn() && !isAnonymous();
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid
      ));
      allow update, delete: if isAdmin();
    }

    // Supplier Fulfillment Orders (B2B purchase orders): strictly restricted to Administrators
    match /supplier_orders/{supplierOrderId} {
      allow read, write: if isAdmin();
    }

    // Real System Alerts (price alerts, stock anomalies, human intervention needed): strictly restricted to Administrators
    match /alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Source Products & Connectors Config: strictly restricted to Administrators
    match /source_products/{sourceProductId} {
      allow read, write: if isAdmin();
    }
    match /source_connectors/{connectorId} {
      allow read, write: if isAdmin();
    }
  }
}


