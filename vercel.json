{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/autopilot/v4/cron/sourcing",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?path=:path*"
    },
    {
      "source": "/victoria",
      "destination": "/seo/victoria.html"
    },
    {
      "source": "/victoria/",
      "destination": "/seo/victoria.html"
    },
    {
      "source": "/contacto",
      "destination": "/seo/starting.html"
    },
    {
      "source": "/contacto/",
      "destination": "/seo/starting.html"
    },
    {
      "source": "/de-mi-para-ti",
      "destination": "/seo/editorial.html"
    },
    {
      "source": "/consultanos",
      "destination": "/seo/consultation.html"
    },
    {
      "source": "/consultanos/",
      "destination": "/seo/consultation.html"
    },
    {
      "source": "/de-mi-para-ti/",
      "destination": "/seo/editorial.html"
    },
    {
      "source": "/nuestros-servicios",
      "destination": "/seo/services.html"
    },
    {
      "source": "/nuestros-servicios/",
      "destination": "/seo/services.html"
    },
    {
      "source": "/tecnologia",
      "destination": "/seo/technology.html"
    },
    {
      "source": "/tecnologia/",
      "destination": "/seo/technology.html"
    },
    {
      "source": "/privacidad",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/privacidad/",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/:page(servicios|contacto|victoria)",
      "destination": "/index.html"
    },
    {
      "source": "/:page(servicios|contacto|victoria)/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/seo/fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
